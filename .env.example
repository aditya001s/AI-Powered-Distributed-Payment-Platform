###############################################################################
# AegisPay - AI-Powered Payment Orchestration & Fraud Intelligence Platform
#
# Copy this file to `.env` and replace every CHANGE_ME value before running.
#   cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real credentials.
# Every value below is read from the environment at runtime - no secret is
# ever hardcoded in source. See the Security section in README.md for the threat model.
###############################################################################

# =============================================================================
# Core / shared
# =============================================================================
# Values: local | docker | kubernetes
PLATFORM_ENV=docker
# Values: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
# Emit machine-parsable JSON logs (true) or human-readable console logs (false)
LOG_JSON=true
DEFAULT_CURRENCY=INR

# =============================================================================
# PostgreSQL
# The compose stack creates one database per service (database-per-service).
# See infrastructure/docker/postgres/00-init-service-databases.sh
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aegis
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
# Superuser database used only by the init script
POSTGRES_DB=aegis_platform

AUTH_DB_NAME=aegis_auth
WALLET_DB_NAME=aegis_wallet
LEDGER_DB_NAME=aegis_ledger
PAYMENT_DB_NAME=aegis_payment
ORCHESTRATOR_DB_NAME=aegis_orchestrator
FRAUD_DB_NAME=aegis_fraud
AI_DB_NAME=aegis_ai
NOTIFICATION_DB_NAME=aegis_notification
ANALYTICS_DB_NAME=aegis_analytics

# One login per service database. POSTGRES_USER is bootstrap administration only;
# application containers receive only their corresponding role/password.
AUTH_DB_PASSWORD=CHANGE_ME_auth_database_password
WALLET_DB_PASSWORD=CHANGE_ME_wallet_database_password
LEDGER_DB_PASSWORD=CHANGE_ME_ledger_database_password
PAYMENT_DB_PASSWORD=CHANGE_ME_payment_database_password
ORCHESTRATOR_DB_PASSWORD=CHANGE_ME_orchestrator_database_password
FRAUD_DB_PASSWORD=CHANGE_ME_fraud_database_password
AI_DB_PASSWORD=CHANGE_ME_ai_database_password
NOTIFICATION_DB_PASSWORD=CHANGE_ME_notification_database_password
ANALYTICS_DB_PASSWORD=CHANGE_ME_analytics_database_password

# =============================================================================
# Redis (idempotency cache, distributed locks, gateway rate limiting)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# =============================================================================
# Kafka (KRaft mode - no ZooKeeper)
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
# Retry attempts before a record is routed to its .DLT dead-letter topic
KAFKA_RETRY_MAX_ATTEMPTS=4
KAFKA_RETRY_INITIAL_INTERVAL_MS=500
KAFKA_RETRY_MULTIPLIER=2.0
KAFKA_RETRY_MAX_INTERVAL_MS=10000

# =============================================================================
# JWT / OAuth2
# The auth-service is the only issuer. It signs access tokens with an RSA
# private key and publishes the public half at /.well-known/jwks.json.
# Every other service validates tokens against that JWKS endpoint, so no
# service ever needs the signing key.
#
# Generate a development key pair:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     -out jwt-private.pem
#   openssl rsa -pubout -in jwt-private.pem -out jwt-public.pem
#
# Then inline them (newlines replaced by literal \n) or mount them as files
# and point JWT_PRIVATE_KEY_LOCATION at the mounted path.
#
# If both are left empty the auth-service generates an EPHEMERAL key pair at
# startup. That is fine for local development but tokens are invalidated on
# every restart, so it is rejected when PLATFORM_ENV=kubernetes.
# =============================================================================
JWT_PRIVATE_KEY_LOCATION=
JWT_PUBLIC_KEY_LOCATION=
JWT_ISSUER=https://auth.aegispay.local
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_JWKS_URI=http://auth-service:8081/.well-known/jwks.json

# Cost factor for BCrypt password hashing. 10-12 is the sane production range.
BCRYPT_STRENGTH=12

# =============================================================================
# Service-to-service authentication (OAuth2 client credentials)
# Internal endpoints (/internal/**) require ROLE_SERVICE + scope=internal.
# Every caller has its own identity and secret for attribution and blast-radius isolation.
# =============================================================================
WALLET_SERVICE_INTERNAL_CLIENT_ID=wallet-service
WALLET_SERVICE_INTERNAL_CLIENT_SECRET=CHANGE_ME_wallet_service_client_secret
LEDGER_SERVICE_INTERNAL_CLIENT_ID=ledger-service
LEDGER_SERVICE_INTERNAL_CLIENT_SECRET=CHANGE_ME_ledger_service_client_secret
PAYMENT_SERVICE_INTERNAL_CLIENT_ID=payment-service
PAYMENT_SERVICE_INTERNAL_CLIENT_SECRET=CHANGE_ME_payment_service_client_secret
PAYMENT_ORCHESTRATOR_INTERNAL_CLIENT_ID=payment-orchestrator
PAYMENT_ORCHESTRATOR_INTERNAL_CLIENT_SECRET=CHANGE_ME_payment_orchestrator_client_secret
FRAUD_SERVICE_INTERNAL_CLIENT_ID=fraud-service
FRAUD_SERVICE_INTERNAL_CLIENT_SECRET=CHANGE_ME_fraud_service_client_secret
NOTIFICATION_SERVICE_INTERNAL_CLIENT_ID=notification-service
NOTIFICATION_SERVICE_INTERNAL_CLIENT_SECRET=CHANGE_ME_notification_service_client_secret
ANALYTICS_SERVICE_INTERNAL_CLIENT_ID=analytics-service
ANALYTICS_SERVICE_INTERNAL_CLIENT_SECRET=CHANGE_ME_analytics_service_client_secret

# =============================================================================
# Service URLs (docker-compose network names)
# =============================================================================
AUTH_SERVICE_URL=http://auth-service:8081
WALLET_SERVICE_URL=http://wallet-service:8082
LEDGER_SERVICE_URL=http://ledger-service:8083
PAYMENT_SERVICE_URL=http://payment-service:8084
ORCHESTRATOR_SERVICE_URL=http://payment-orchestrator:8085
FRAUD_SERVICE_URL=http://fraud-service:8086
AI_SERVICE_URL=http://ai-investigation-service:8087
NOTIFICATION_SERVICE_URL=http://notification-service:8088
ANALYTICS_SERVICE_URL=http://analytics-service:8089
ML_SERVICE_URL=http://ml-service:8000
GATEWAY_URL=http://api-gateway:8080

# =============================================================================
# Rate limiting (enforced at the gateway, backed by Redis)
# =============================================================================
RATE_LIMIT_REPLENISH_RATE=20
RATE_LIMIT_BURST_CAPACITY=40
RATE_LIMIT_REQUESTED_TOKENS=1
# Stricter bucket for unauthenticated auth endpoints (credential stuffing)
AUTH_RATE_LIMIT_REPLENISH_RATE=3
AUTH_RATE_LIMIT_BURST_CAPACITY=6
# Staff-only operational surfaces (/api/orchestration/**, /api/fraud/**). Lower,
# because they are used by a handful of operators and analysts rather than by
# traffic, and their queries are the expensive ones: a saga read assembles the step
# log and every provider call, and an assessment detail read assembles the feature
# snapshot and every decision on the payment.
ADMIN_RATE_LIMIT_REPLENISH_RATE=10
ADMIN_RATE_LIMIT_BURST_CAPACITY=20

# =============================================================================
# Payment orchestration (payment-orchestrator)
#
# The saga routes each charge across three SIMULATED payment providers. Nothing
# here contacts a real bank, card network or UPI rail.
# =============================================================================
# Hard ceiling on ONE provider call. Applied per attempt rather than across the
# retry sequence, so a first attempt that hangs cannot consume the whole budget
# and leave no time to fall back to another provider.
PROVIDER_CALL_TIMEOUT=3s
# Shorter than a real call: a probe that hangs must not delay the health sweep.
PROVIDER_PROBE_TIMEOUT=2s
# Attempts against a SINGLE provider, including the first. Kept low: retries
# multiply load on a dependency that is already struggling, and breadth (falling
# back to another provider) beats depth. Applies only to faults known to have
# happened before the request reached the provider - a timeout is never retried
# on the same provider, because the charge may already have gone through.
PROVIDER_MAX_ATTEMPTS=2
PROVIDER_HEALTH_INTERVAL=30s
# Threads available for provider calls, and therefore the cap on concurrent
# in-flight charges. Bounded deliberately: better to queue behind a known limit
# than to discover the limit as an out-of-memory error.
PROVIDER_CALL_POOL_SIZE=8

# The stalled-saga sweep. Turning this off means a saga whose orchestrating
# thread died stays in flight with the customer's funds reserved until the
# wallet's hold-expiry sweeper frees them - and the payment never reaches a
# terminal state at all. Off only for tests that drive recovery directly.
SAGA_RECOVERY_ENABLED=true
# How long a saga may go without a state change before it is treated as
# abandoned. Comfortably longer than the slowest legitimate saga: too short and
# a payment waiting on a slow provider is compensated out from under itself.
SAGA_STALLED_AFTER=2m

# =============================================================================
# Fraud intelligence (fraud-service)
#
# A payment is HELD at or above the high threshold, REVIEWED at or above the
# medium one, otherwise APPROVED. The thresholds are probabilities, and they only
# mean anything because the model is isotonically calibrated - the training run
# reports the calibration error that makes 0.80 read as a risk score of 80.
#
# Measured on held-out data:
#   at 0.80  precision 0.809  recall 0.441  alert rate 0.94%
#   at 0.45  precision 0.804  recall 0.847  alert rate 1.82%
# The alert rate is what decides whether a threshold is usable at all: one that
# flags 10% of traffic is not a fraud control, it is a manual review department.
#
# CRITICAL / REJECT is deliberately unreachable from a probability, however high.
# An automatic refusal requires evidence needing no judgement, which in practice
# means a human has already confirmed fraud on the account (see the rules below).
# =============================================================================
FRAUD_HIGH_RISK_THRESHOLD=0.80
FRAUD_MEDIUM_RISK_THRESHOLD=0.45

# The scoring call sits on the payment's critical path, ahead of a provider
# authorisation with a 3s budget of its own, so a slow model eats the saga's
# headroom. Falling back to rules in a fifth of a second beats making every
# payment wait.
ML_TIMEOUT=1200ms
# Safe to retry, unlike a provider authorisation: scoring is a pure function with
# no side effect, so a duplicate call charges nobody and returns the same answer.
ML_MAX_ATTEMPTS=2
ML_RETRY_INTERVAL=80ms

# What happens when the MODEL is unreachable. FALSE = fall back to the
# deterministic rules and mark the verdict degradedMode. Refusing every payment
# while the model is down converts a fraud-service outage into a total payment
# outage - a far larger incident than the fraud it prevents - and the rules cover
# precisely the archetypes the model scores worst on. Set true only where refusing
# a payment is genuinely cheaper than missing fraud.
FRAUD_REJECT_WHEN_ML_UNAVAILABLE=false

# -----------------------------------------------------------------------------
# Rule tuning.
#
# The rules exist because the model's weaknesses were MEASURED, not assumed.
# Recall per attack archetype on held-out data at the blocking threshold:
#   account_takeover 0.71   card_testing 0.60   mule_cashout 0.33
#   bust_out 0.15           friendly_fraud 0.00
# Bust-out is carried almost entirely by a rule. Rules ESCALATE ONLY: none can
# lower what the model raised.
# -----------------------------------------------------------------------------
FRAUD_VELOCITY_WINDOW=24h
# Bust-out needs the CONJUNCTION - established history, a large multiple of the
# account's historic maximum, AND a payee never paid before. Exceeding the
# historic maximum alone is far too common to act on: customers make their
# largest-ever purchase all the time.
FRAUD_BUST_OUT_MULTIPLE=1.6
FRAUD_BUST_OUT_MIN_HISTORY=20
# Card testing needs both signals. Failures alone are ordinary (an expiring card
# produces them); a burst alone is a customer doing their shopping.
FRAUD_CARD_TESTING_FAILURES=5
FRAUD_CARD_TESTING_ATTEMPTS=5
# Roughly a commercial jet. Above this the two payments cannot both be the same
# person travelling. Deliberately not lower: a real flight plus an airport VPN
# produces surprisingly high figures.
FRAUD_IMPOSSIBLE_TRAVEL_KMH=900.0
FRAUD_NEW_DEVICE_MULTIPLE=5.0
FRAUD_DORMANT_DAYS=90
FRAUD_DORMANT_MULTIPLE=3.0
# The ONLY automatic rejection in the platform, and it rests on a human having
# already confirmed fraud on this account this many times.
FRAUD_CONFIRMED_REVIEW_COUNT=1
FRAUD_CONFIRMED_BLOCK_COUNT=3

# =============================================================================
# How the saga treats the risk step (payment-orchestrator)
# =============================================================================
# Wider than ML_TIMEOUT, because fraud-service is expected to absorb a slow model
# and still answer: it runs its rules, gives up on ml-service, and returns a
# degraded verdict. A breach here means fraud-service itself is unwell.
FRAUD_CALL_TIMEOUT=4s
FRAUD_MAX_ATTEMPTS=2

# Whether a payment may proceed when FRAUD-SERVICE ITSELF is unreachable.
# Stricter than FRAUD_REJECT_WHEN_ML_UNAVAILABLE, and the reasoning differs: a
# model outage still leaves the deterministic rules running, so there is a real
# compensating control. A fraud-service outage leaves NONE - no score, no rules,
# nothing - and recording an unassessed payment as approved would be a false
# statement in the audit trail of an automated decision. Failing is recoverable
# (nothing was charged, the reservation is released) and makes the outage visible
# as failed payments rather than invisible as unprotected ones.
ALLOW_UNASSESSED_PAYMENTS=false

# How long the wallet reservation is extended for when a payment is HELD for
# review. The saga's default 15-minute hold is sized for a payment that completes
# in seconds; without this the wallet's expiry sweeper would release the funds
# while the saga still believed they were held, and the analyst releasing the
# payment would capture against a balance that had moved underneath them.
# Two days covers a weekend. Longer would mean a forgotten alert sits on a
# customer's money instead of eventually freeing it.
FRAUD_REVIEW_HOLD_TTL=2d

# =============================================================================
# ML service (Python / FastAPI)
#
# Measurement only: it returns a calibrated probability, a 0-100 score and
# per-feature explanations. It does NOT decide APPROVE / REVIEW / HOLD / REJECT - bucketing
# a probability needs the deterministic rules as well as the model, and only
# fraud-service has both. Keeping the thresholds out of here also means retuning
# one is a config change reviewed by a fraud team, not a model redeploy.
#
# The model is trained at IMAGE BUILD time, not on boot. Two replicas training
# themselves would disagree about the same payment.
#
# SYNTHETIC DATA. The generator produces transactions with deliberate,
# bidirectional label noise (unreported fraud caps precision, friendly fraud caps
# recall) because a naive generator scored ROC AUC 0.9999, which is meaningless.
# The reported metrics describe the generator's fraud patterns and NOT any real
# population. Read them as evidence that the pipeline works.
# =============================================================================
MODEL_DIR=/app/models
# fraud_hgb: scikit-learn HistGradientBoostingClassifier, wrapped in an isotonic
# CalibratedClassifierCV. Named honestly - it is not LightGBM, and claiming
# otherwise in a version string would be a false provenance record.
MODEL_NAME=fraud_hgb
ML_TRAINING_ROWS=120000
ML_FRAUD_RATE=0.017
# Fixed, so a rebuild produces an identical model. A model that changed on every
# build would make a disputed score impossible to reproduce six months later.
ML_RANDOM_SEED=42
# Shared secret sent as X-API-Key. Empty means UNAUTHENTICATED on both sides,
# which is consistent rather than broken - acceptable on a laptop. In any shared
# environment an open scoring endpoint lets anyone map the model's decision
# boundary by probing it, which is what makes a fraud model cheap to evade.
ML_API_KEY=CHANGE_ME_ml_service_api_key
ML_LOG_LEVEL=INFO

# =============================================================================
# AI investigation service
#
# Grounded fraud-investigation reports: retrieve the fraud policy that applies
# to a flagged payment, then write a cited explanation of why it was flagged.
#
# Guardrail: the AI can only RECOMMEND. It can never move money or block an
# account. That is not a policy anybody has to remember - the service runs with
# service-to-service auth DISABLED, so it holds no credential that any internal
# write API would accept. Acting on a recommendation requires a separate human
# decision, attributed to that person's token and recorded in fraud-service.
# =============================================================================

# --- generation ---------------------------------------------------------------
# local  -> the offline composer. Not a stub: it writes a real report from the
#           evidence and the retrieved policy, and every report it writes is
#           flagged deterministicFallback so an analyst knows what they are
#           reading. What it does not do is interpret beyond its inputs.
# openai | anthropic -> a hosted language model.
# Anything else needs AI_API_BASE_URL set, which is how a self-hosted or
# OpenAI-compatible gateway deployment is expressed - and how a deployment that
# will not send payment data to a third party can still use a language model.
#
# Default is local, so the platform runs end to end with no key and no outbound
# network access. A missing key only WARNS and falls back; contrast the knowledge
# base below, where a failure to seed prevents startup. The asymmetry is
# deliberate: a fallback generator still produces a truthful report, while there
# is no fallback for having no policy to reason from.
AI_PROVIDER=local
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_API_BASE_URL=

# A Duration, not milliseconds. Generous by platform standards because an
# investigation is NOT on the payment's critical path - fraud-service has already
# decided, so a slow model delays an analyst's reading rather than a customer's
# payment. Still bounded, or a hung call holds a Kafka consumer thread and every
# investigation queued behind it.
AI_REQUEST_TIMEOUT=20s
AI_MAX_ATTEMPTS=2
AI_MAX_OUTPUT_TOKENS=800
# Near zero: this is evidence summarisation, not a creative task, and two
# analysts opening the same investigation should read the same words.
AI_TEMPERATURE=0.1
# A failed hosted generation falls back to the offline composer. Dead-lettering
# instead would leave the payment quietly uninvestigated.
AI_FALLBACK_TO_LOCAL=true
# Hard cap on any single customer-controlled field placed in a prompt. An
# injection defence, and a blunt one on purpose: the closed recommendation
# vocabulary means an injection cannot produce an action, but it can still burn
# the context window and derail the narrative.
AI_MAX_UNTRUSTED_FIELD_LENGTH=240

# --- retrieval ----------------------------------------------------------------
# How many chunks vector search contributes. Small deliberately: a model given
# eight loosely-relevant policies will find a way to cite all eight, and a
# narrative that cites everything has cited nothing.
RAG_TOP_K=5

# THE most consequential number in this service. An approximate nearest-neighbour
# search always returns its k nearest neighbours however far away they are, so
# without a floor a payment with no relevant policy retrieves the five
# least-irrelevant documents in the corpus and the narrative cites them as though
# they mattered. This floor is what makes "no policy matched" an expressible
# outcome.
#
# 0.28 is tuned for the default LEXICAL embedder, where an on-topic passage
# scores roughly 0.35-0.7 and an unrelated one below 0.15. A semantic embedder
# has a much narrower and higher distribution and would need this retuned, which
# is why the embedder id is recorded on every report.
RAG_MINIMUM_SIMILARITY=0.28

# Policies whose author declared them as explaining a fired rule are always
# included, ahead of anything found by similarity. This is what makes retrieval
# reliable rather than merely plausible: vector search finds policy that
# RESEMBLES the payment, while the declared mapping finds the policy that DEFINES
# the rule that actually fired. Turning this off leaves only resemblance.
RAG_ALWAYS_INCLUDE_RULE_POLICIES=true

# Prompt budget for retrieved policy, in approximate tokens. Separate from the
# model's context limit: the evidence, the instructions and the expected output
# all need room, and a retrieval set that filled the window would push the
# instructions out - which is how a model starts ignoring its output format.
RAG_CONTEXT_TOKEN_BUDGET=2000

# --- knowledge base -----------------------------------------------------------
# The bundled fraud policies are seeded at startup and embedded by the running
# code. FATAL on failure: a service that came up with an empty corpus would
# answer every investigation ungrounded and report no error at all, which is the
# worst kind of broken.
RAG_SEED_ON_STARTUP=true
# Compares version numbers rather than body text, so bumping a policy's version
# takes effect while a whitespace change does not re-embed the whole corpus.
RAG_UPGRADE_DOCUMENTS=true
RAG_CHUNK_TARGET_TOKENS=180
RAG_CHUNK_MAX_TOKENS=300
# Non-zero so a claim spanning a paragraph break stays retrievable from either
# side. Zero overlap makes every boundary a place where a policy sentence becomes
# unreachable by the query that should have found it.
RAG_CHUNK_OVERLAP_TOKENS=30

# NOTE: there is deliberately no RAG_EMBEDDING_DIMENSIONS. The dimension is fixed
# at 384 by the embedder and by the vector(384) column, and a variable that
# disagreed with either would fail every insert rather than reconfigure anything.
# NOTE: there is also no variable for the recommendation vocabulary. It is a
# compiled enum plus a database CHECK, because it is the one field a prompt
# injection targets - a list extendable by an environment variable would be a
# config change away from a value some consumer treats as a command.

# =============================================================================
# Payment providers (SIMULATED - this platform never contacts a real bank,
# card network or UPI switch. See the Phase 5 section in README.md.)
# =============================================================================
PROVIDER_A_ENABLED=true
PROVIDER_A_BASE_LATENCY_MS=120
PROVIDER_A_FAILURE_RATE=0.04
PROVIDER_A_FEE_BPS=25

PROVIDER_B_ENABLED=true
PROVIDER_B_BASE_LATENCY_MS=220
PROVIDER_B_FAILURE_RATE=0.02
PROVIDER_B_FEE_BPS=35

PROVIDER_C_ENABLED=true
PROVIDER_C_BASE_LATENCY_MS=90
PROVIDER_C_FAILURE_RATE=0.09
PROVIDER_C_FEE_BPS=18

# Resilience4j circuit breaker (per provider)
CB_FAILURE_RATE_THRESHOLD=50
CB_SLOW_CALL_RATE_THRESHOLD=60
CB_SLOW_CALL_DURATION_MS=1500
CB_SLIDING_WINDOW_SIZE=20
CB_MINIMUM_NUMBER_OF_CALLS=8
CB_WAIT_DURATION_IN_OPEN_STATE_MS=15000
CB_PERMITTED_CALLS_IN_HALF_OPEN=4

# =============================================================================
# Observability
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLER_ARG=1.0
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# =============================================================================
# Notifications
#
# Multi-channel customer notifications: email, SMS and an in-app inbox.
#
# TRANSPORTS ARE SIMULATED. No SMTP relay and no SMS gateway is contacted, exactly
# as no real bank, card network or UPI switch is. What is NOT simulated is
# everything around the send - rendering, escaping, per-channel idempotency, the
# retry schedule, the dead-letter queue and the audit trail all behave identically
# whether the send is real or not, because they sit above the transport interface.
# Swapping in a real transport means adding spring-boot-starter-mail and one class.
#
# PUSH is deliberately unimplemented. There is no mobile application and no
# device-token registry to send to, so a request for it is recorded as suppressed
# with reason CHANNEL_UNAVAILABLE rather than silently dropped.
# =============================================================================
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=true

# Sender identity. The SMS sender id is capped at 11 characters because that is
# what real networks accept for an alphanumeric sender; a longer one is rejected
# or silently truncated by the carrier.
NOTIFICATION_EMAIL_FROM=no-reply@aegispay.local
NOTIFICATION_EMAIL_FROM_NAME=AegisPay
NOTIFICATION_SMS_SENDER_ID=AEGISPAY

# Injected failure rate for the simulated transports, 0.0 to 1.0.
#
# Zero by default, and raising it is how the retry and dead-letter paths get
# exercised deliberately - a dead-letter queue that only fills during a real
# provider outage is a mechanism nobody has ever seen work. A non-zero default
# would make every local run produce dead letters and teach everyone to ignore
# the queue, which is worse than not having one.
NOTIFICATION_SIMULATED_FAILURE_RATE=0.0
NOTIFICATION_SIMULATED_LATENCY=0ms

# --- delivery retry -----------------------------------------------------------
# SEPARATE from KAFKA_RETRY_* above, and the distinction is the core of this
# service's design.
#
# A Kafka retry is for a record that could not be PROCESSED. It blocks the
# partition and re-runs the whole handler, so it is short and narrow.
#
# A delivery retry is for a message that could not be SENT, and must not use the
# Kafka path at all: backing off a partition because one SMTP host is slow would
# stop every later notification to every other customer, a redelivery would
# re-attempt the channels that already succeeded, and a Kafka DLT is a topic
# rather than a work queue - nothing retries it on a schedule and nothing can
# answer "which customers are currently un-notified".
#
# So a send failure is committed as state and drained from the database by a
# scheduled worker. Failures that exhaust the budget become DEAD_LETTERED rows,
# which an operator can list and replay through /api/admin/notifications.
NOTIFICATION_RETRY_POLL_INTERVAL=5s
NOTIFICATION_RETRY_INITIAL_DELAY=15s
NOTIFICATION_RETRY_BATCH_SIZE=50

# Total attempts including the first. Eight with the backoff below spans roughly
# half an hour: long enough to ride out a provider restart, short enough that a
# genuinely broken destination reaches the dead-letter queue while somebody is
# still on shift.
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_INITIAL_BACKOFF=30s
NOTIFICATION_BACKOFF_MULTIPLIER=2.0
# Without a ceiling the eighth attempt would be over two hours after the seventh,
# and a notification about a payment is worth less the later it arrives.
NOTIFICATION_MAX_BACKOFF=10m

# Every instance sweeps on the same interval and a provider outage fails every
# delivery at once. Without jitter the whole backlog comes due in the same second
# and re-overloads the provider that just recovered, then fails together again in
# lockstep until the attempts run out.
NOTIFICATION_RETRY_JITTER=0.25

# Extra attempts an operator's replay is granted. Granted rather than reset: a
# full reset would let a permanently broken destination be replayed forever, each
# replay looking like a fresh start and costing a whole run of attempts.
NOTIFICATION_REPLAY_ATTEMPT_GRANT=3

# --- recipient resolution -----------------------------------------------------
# An email address is resolved from auth-service per delivery rather than copied
# into this database: it is an identity attribute, so a customer who changes it
# starts receiving notifications at the new one on the next message.
#
# A phone number is NOT resolved from auth-service - it lives in this service's
# own preferences alongside the SMS consent that justifies it. Nobody logs in with
# a phone number, so it is not an identity attribute; keeping it beside the consent
# means the two cannot become separated, and it keeps a phone number out of the
# service every other service queries for identity.
#
# The lookup timeout is short because it sits between a Kafka record arriving and
# a durable write. A slow identity service must not hold a consumer thread, and
# since the notification can be retried, failing fast beats waiting.
NOTIFICATION_LOOKUP_TIMEOUT=2s
# Caching is an honest trade: a customer who changes their email keeps receiving
# notifications at the old address for up to this long. Ten minutes puts that
# window inside one support call rather than one billing cycle.
NOTIFICATION_CONTACT_CACHE_TTL=10m
NOTIFICATION_CONTACT_CACHE_MAX=10000

# NOTE: there is deliberately no variable governing whether a HIGH-priority
# notification honours a channel opt-out. It never does, and that is compiled in
# rather than configurable - a flag able to switch it off would be one environment
# variable between a customer and never being told their account was accessed from
# a new device, and the change would read as routine tuning in a diff.

# =============================================================================
# Analytics read model (analytics-service)
#
# This service stores ONE ROW PER PAYMENT and derives every total, rate and time
# series from those rows on demand. It keeps no counters, and that is the whole
# design: Kafka delivers at least once, so a redelivered payment-completed would
# increment a counter twice and nothing in the stored data would reveal it. A
# projection merely re-writes the same row.
#
# There is deliberately no variable to switch that off in favour of counters. It
# would trade correctness for latency in a way no operator could detect afterwards.
# =============================================================================

# Lag beyond which a consumed topic is reported stale on every API response.
#
# NOT a hard failure - the API still answers and still returns the numbers it has.
# It sets the flag that tells a reader the figures are historical, because a
# projection that stops updating does not go blank: it keeps serving the last
# numbers it had, confidently. An operator reading "0 payments held for review"
# cannot otherwise tell whether the queue is clear or the consumer died three
# hours ago, and those call for opposite responses.
#
# Two minutes is measured against the platform's own cadence: the outbox drains
# every 200ms and consumers commit per record, so healthy lag is sub-second. Far
# enough above that to absorb a rolling restart without crying wolf, and short
# enough that a dead consumer is flagged while somebody is still looking.
ANALYTICS_STALE_AFTER=2m

# The label on aggregate totals. Aggregates sum minor units across rows, and minor
# units are only comparable within one currency.
#
# This service does NOT convert. It has no rate source, and inventing one would
# produce authoritative-looking totals derived from a made-up number. So this label
# is honest only while the platform is single-currency; multi-currency support means
# grouping by currency in every aggregate, not adding a conversion here.
ANALYTICS_REPORTING_CURRENCY=INR

# Largest page the platform-wide payment list will return. Bounded because that
# list spans every customer: a customer-scoped endpoint is naturally limited by how
# many payments one person made, this one only by what a caller asks for.
ANALYTICS_MAX_PAGE_SIZE=100

# =============================================================================
# Admin dashboard
#
# Browser requests are root-relative `/api` calls. Vite proxies them to the local
# gateway during source development, and Compose nginx uses its internal
# API_UPSTREAM setting. No public endpoint is compiled into the bundle.
#
# NEVER PUT A SECRET IN A VITE_* VARIABLE. Every such value is readable by anyone
# who opens the JavaScript bundle.
# =============================================================================
VITE_APP_NAME=AegisPay

# =============================================================================
# Demo identities
# Seeded by auth-service CredentialSeeder only when DEMO_SEED_ENABLED=true.
# Wallets and business transactions are not seeded here; panel-demo.ps1 creates them.
# Never enable in production. The panel helper enables it only in the untracked .env.
# =============================================================================
DEMO_SEED_ENABLED=false
DEMO_USER_EMAIL=demo.user@aegispay.local
DEMO_USER_PASSWORD=CHANGE_ME_DemoUser#2026
DEMO_MERCHANT_EMAIL=demo.merchant@aegispay.local
DEMO_MERCHANT_PASSWORD=CHANGE_ME_DemoMerchant#2026
DEMO_ADMIN_EMAIL=demo.admin@aegispay.local
DEMO_ADMIN_PASSWORD=CHANGE_ME_DemoAdmin#2026
