<?xml version="1.0" encoding="UTF-8"?>
<!--
  AegisPay - AI-Powered Payment Orchestration & Fraud Intelligence Platform

  Root aggregator + parent POM for every JVM module in the monorepo.

  Version strategy: this project pins EXACT versions (no ranges) so that a
  clone six months from now resolves the same bytecode. The compatibility
  triple that matters:

    Spring Boot   4.0.8   (Spring Framework 7, Jakarta EE 11, Java 17 baseline
                           with first-class Java 25 support)
    Spring Cloud  2025.1.3 (the release train built against Boot 4.0.x;
                           ships Gateway 5.0.x)
    Java          25      (LTS, released 2025-09)

  Resilience4j is deliberately used through its PROGRAMMATIC API (registries
  wired in @Configuration classes) rather than the Spring Boot starter. The
  starter's autoconfiguration lags new Boot majors, and programmatic wiring
  gives explicit, testable control over every circuit breaker.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.aegispay</groupId>
    <artifactId>aegispay-platform</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>AegisPay Platform</name>
    <description>
        Cloud-native, event-driven payment orchestration platform with ML fraud
        scoring and RAG-based AI fraud investigation.
    </description>

    <modules>
        <!-- Shared kernel: money, events, outbox, locks, security, observability -->
        <module>platform-common</module>

        <!-- Edge -->
        <module>api-gateway</module>

        <!-- Core domain services -->
        <module>auth-service</module>
        <module>wallet-service</module>
        <module>ledger-service</module>
        <module>payment-service</module>
        <module>payment-orchestrator</module>

        <!-- Intelligence services -->
        <module>fraud-service</module>
        <module>ai-investigation-service</module>

        <!-- Supporting services -->
        <module>notification-service</module>
        <module>analytics-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Managed third-party versions -->
        <!-- Must match the <parent> version above. Referenced explicitly because
             ${project.parent.version} resolves to THIS project's version in child
             modules, not to Spring Boot's. -->
        <spring-boot.version>4.0.8</spring-boot.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <springdoc.version>3.0.3</springdoc.version>
        <logstash-logback-encoder.version>8.1</logstash-logback-encoder.version>
        <archunit.version>1.4.1</archunit.version>
        <!-- Spring Boot 4 no longer manages Testcontainers versions (Boot 3 did),
             so its BOM is imported explicitly below. -->
        <testcontainers.version>2.0.5</testcontainers.version>

        <!-- Surefire/Failsafe: Mockito 5+ needs the inline mock maker attached
             as a java agent on modern JDKs. -->
        <argLine>-Xshare:off</argLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Integration tests run against real PostgreSQL and Kafka containers
                 rather than in-memory substitutes, because the behaviours under test
                 (row locking, SKIP LOCKED, consumer rebalancing) do not exist in an
                 in-memory fake. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>

            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.aegispay</groupId>
                <artifactId>platform-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Shared integration-test support: the RS256 token issuer and JWKS
                 server that every service's integration tests authenticate through. -->
            <dependency>
                <groupId>com.aegispay</groupId>
                <artifactId>platform-common</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      Dependencies every module gets. Kept intentionally tiny: Lombok (compile
      only), and the standard test toolchain.
    -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <includes>
                            <include>**/*IT.java</include>
                            <include>**/*IntegrationTest.java</include>
                        </includes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <!-- -parameters keeps constructor/handler parameter names at
                         runtime, which Spring MVC and Jackson rely on. -->
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring-boot.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Unit tests only; *IT / *IntegrationTest belong to failsafe
                         because they need Docker (Testcontainers). -->
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
