<?xml version="1.0" encoding="UTF-8"?>
<!--
  platform-common: the shared kernel.

  Everything here is infrastructure that MUST behave identically in every
  service: how money is represented, what an event looks like on the wire, how
  the transactional outbox drains, how distributed locks are taken, how errors
  are rendered to clients.

  Dependency policy: heavyweight Spring starters are declared <optional>true</optional>.
  Optional dependencies are on THIS module's compile classpath but are not
  transitively forced onto consumers. That is what lets the WebFlux-based
  api-gateway reuse this module without dragging in the servlet stack, and lets
  the AI service skip Kafka entirely.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aegispay</groupId>
        <artifactId>aegispay-platform</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>platform-common</artifactId>
    <name>AegisPay :: Platform Common</name>
    <description>Shared kernel: money, events, outbox, locks, security, resilience, observability.</description>

    <dependencies>
        <!-- Always needed: config binding, validation annotations, Jackson -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          JSON support, declared NON-optional and at this level deliberately.

          Several shared components take an ObjectMapper as a constructor argument
          (GlobalExceptionHandler, StandardSecurityConfig, KafkaEventCodec), so JSON
          is a hard requirement of this module rather than an optional extra.

          spring-boot-starter-json, not a bare jackson-databind dependency: the
          starter also brings Spring Boot's Jackson AUTOCONFIGURATION, which is what
          actually publishes the ObjectMapper bean and applies the spring.jackson.*
          properties from aegis-defaults.yml. Depending on jackson-databind alone
          puts the classes on the classpath with no bean defined, which fails at
          startup rather than at compile time.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Structured JSON logging with trace/span/correlation fields -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <!-- Observability: metrics + OTLP trace export -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Servlet web: correlation filter + @RestControllerAdvice error mapping -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Shared OpenAPI document builder. Optional: a service opts in by
             declaring the springdoc starter itself. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- RestClient based service-to-service calls -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Security: JWT resource server plumbing shared by all services -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Transactional outbox entity + repository -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Redis: distributed locks + idempotency reservations -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Kafka: event publishing, DLQ-aware error handling -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Resilience4j used programmatically (no Spring Boot starter) -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-timelimiter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
        </dependency>

        <!-- Test-only -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Publishes src/test/java as a test-jar so every service can share
              com.aegispay.common.testsupport: the RS256 token issuer and the JWKS
              server that integration tests authenticate through.

              Shared rather than copied for the same reason StandardSecurityConfig is
              shared. A per-service copy of a security test helper drifts, and a drifted
              helper stops testing what it was written for while still passing. The
              alternative, weaker option would be @WithMockUser in each service, which
              skips signature, issuer and expiry validation entirely.

              Only the test-support package is intended for reuse; the unit tests come
              along in the jar and are simply never referenced.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
